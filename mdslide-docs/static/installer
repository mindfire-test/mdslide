#!/bin/bash

set -e

# Repository information
REPO="mindfiredigital/mdslide"

echo "Installing mdslide..."

# Determine OS
OS="$(uname -s)"
case "${OS}" in
Linux*)     target_os=linux;;
Darwin*)    target_os=darwin;;
*)          echo "Unsupported OS: ${OS}"; exit 1;;
esac

# Determine architecture
ARCH="$(uname -m)"
case "${ARCH}" in
x86_64|amd64)   target_arch=x64;;
aarch64|arm64)  target_arch=arm64;;
*)              echo "Unsupported architecture: ${ARCH}"; exit 1;;
esac

BINARY_NAME="mdslide-${target_os}-${target_arch}"

echo "Detected OS: ${target_os}"
echo "Detected Arch: ${target_arch}"

# Construct download URL
DOWNLOAD_URL="https://github.com/${REPO}/releases/latest/download/${BINARY_NAME}"

# Define installation directory
INSTALL_DIR="/usr/local/bin"
DEST="${INSTALL_DIR}/mdslide"

echo "Downloading latest version of mdslide from ${DOWNLOAD_URL}..."

# Download binary to a temporary location, with a visible progress bar
TMP_FILE=$(mktemp)
if ! curl -fL --progress-bar "$DOWNLOAD_URL" -o "$TMP_FILE"; then
  echo "Error: Failed to download binary from $DOWNLOAD_URL"
  rm -f "$TMP_FILE"
  exit 1
fi

# Fetch verification checksum
echo "Fetching verification checksum..."
CHECKSUM_URL="${DOWNLOAD_URL}.sha256"

# -f flag ensures curl fails silently on 404 instead of saving error HTML
EXPECTED_HASH=$(curl -fsSL "$CHECKSUM_URL" | awk '{print $1}')

if [ -z "$EXPECTED_HASH" ]; then
  echo "Error: Checksum file not found at $CHECKSUM_URL"
  echo "Please verify that the release assets include the .sha256 payload."
  rm -f "$TMP_FILE"
  exit 1
fi

# Detect operating system hashing tool (Linux vs macOS)
if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL_HASH=$(sha256sum "$TMP_FILE" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  ACTUAL_HASH=$(shasum -a 256 "$TMP_FILE" | awk '{print $1}')
else
  echo "Error: Neither sha256sum nor shasum tools were found on your system."
  rm -f "$TMP_FILE"
  exit 1
fi

# Validate file integrity
if [ "$EXPECTED_HASH" != "$ACTUAL_HASH" ]; then
  echo "Security Error: Checksum mismatch! The downloaded binary is compromised or corrupted."
  rm -f "$TMP_FILE"
  exit 1
fi

echo "Integrity verification successful."

chmod 0755 "$TMP_FILE"

# Move to install directory
echo "Installing to ${DEST}..."
if [ -w "$INSTALL_DIR" ]; then
  mv "$TMP_FILE" "$DEST"
else
  echo "Administrative privileges are required to install to ${INSTALL_DIR}."
  sudo mv "$TMP_FILE" "$DEST"
fi

echo ""
echo "mdslide was installed successfully!"
echo "Run 'mdslide --help' to get started."
